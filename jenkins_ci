pipeline {
    agent {
        label 'builtin'
    }

    stages {

        stage('Install Lint Tools') {
            steps {
                sh '''
                    python3 -m pip install --upgrade pip
                    python3 -m pip install yamllint ansible-lint
                '''
            }
        }

        stage('Run yamllint') {
            steps {
                sh '''
                    yamllint playbooks/
                    yamllint inventory/
                '''
            }
        }

        stage('Run ansible-lint') {
            steps {
                sh '''
                    ansible-lint playbooks/
                '''
            }
        }
    }

    post {
        always {
            cleanWs()
        }

        success {
            echo "CI passed successfully"
        }

        failure {
            echo "CI failed - fix issues before merge"
        }
    }
}